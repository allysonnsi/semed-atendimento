# Sem estas variáveis, o sistema roda em modo DEMONSTRAÇÃO
# (dados em memória, ver src/lib/db/store.ts).
#
# Para conectar o backend real:
# 1. Crie um projeto em https://supabase.com
# 2. Rode as migrations em supabase/migrations/ (SQL editor ou Supabase CLI)
# 3. Preencha os valores abaixo com os dados do seu projeto (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
